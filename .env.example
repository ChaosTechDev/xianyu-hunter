# =============================================================================
# 闲鱼监控 环境变量配置模板
#
# 用法：
#     cp .env.example .env
#     然后按下面的注释填写，改完执行 docker compose up -d 生效。
#
# ⚠️ 这是**唯一**的配置入口。
#    不要改 docker-compose.yml 里的 environment 块 —— 那里只放系统级键
#    （APP_DATABASE_FILE / SERVER_PORT / RUNNING_IN_DOCKER /
#      PLAYWRIGHT_BROWSERS_PATH / TZ），它们的值由镜像与容器结构决定。
#    compose 的 environment 块优先级高于 .env，历史版本在这里硬编码过
#    OPENAI_API_KEY="" / BARK_URL 等占位符，把用户真实配置静默压掉，
#    造成"网页显示已配置、实际 AI 完全失效"。为杜绝复发，用户配置一律只写本文件。
#
# ⚠️ 系统级键请勿写入本文件：
#    本文件内容会以更高优先级覆盖 compose 的 environment 块。以下键若写在这里
#    会破坏容器结构（端口错配 / 浏览器通道失效 / 数据不落盘）：
#      SERVER_PORT            容器内监听端口由 compose 固定 8000，
#                             对外端口请改 compose 的 ports 映射
#      RUNNING_IN_DOCKER      必须保持 true，否则会去启动镜像内不存在的 Chrome 通道
#      PLAYWRIGHT_BROWSERS_PATH / APP_DATABASE_FILE
#    因此这 4 个键在本文件中一律保持注释状态。
#
# 📌 其他说明：
#    - 布尔值统一写 true / false（小写）
#    - 含空格或特殊字符的值请用引号包裹，例如 WEBHOOK_HEADERS='{"X-A":"1"}'
#    - 网页设置页保存配置时会重写本文件，届时本文件内的注释会被清除，
#      只保留键值对。建议在别处留存一份带注释的副本（如本模板）。
# =============================================================================


################################################################################
# 1. Web 认证
#    保护控制台，防止他人篡改配置、查看采集结果。
################################################################################

# 登录用户名（默认 admin）。
WEB_USERNAME=admin

# 登录密码（默认 admin123）。
# ⚠️ 生产环境务必修改，且不要使用 your_admin_password 这类占位符
#    （系统会把含 "your_" 的值判定为"未配置"）。
WEB_PASSWORD=admin123

# 会话签名密钥（可选）。
# 留空时系统会自动生成并持久化到 data/.session_secret，重启不失效。
# 多实例部署或需要固定密钥时才填写，建议 32 位以上随机串。
# WEB_SESSION_SECRET=

# 登录会话有效期（小时，默认 72）。过期后需要重新登录。
SESSION_TTL_HOURS=72


################################################################################
# 2. AI 模型（智能分析）
#    不配置也能跑：此时退化为纯关键词匹配模式。
#    ⚠️ 必须选择支持图片输入的多模态（Vision）模型，商品图分析依赖此能力。
################################################################################

# API Key。部分自建/中转服务可为空。
OPENAI_API_KEY=

# 接口地址，需兼容 OpenAI 格式。结尾带 /v1/ 的居多。
# 例：https://api.openai.com/v1/
OPENAI_BASE_URL=

# 模型名称。必须是多模态模型。
OPENAI_MODEL_NAME=

# 为 AI 请求单独配置代理（可选），支持 http / socks5。
# 例：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# PROXY_URL=

# --- AI 行为微调 ---

# 调试模式（默认 false）。开启后控制台打印完整 AI 请求/响应，排查问题用。
AI_DEBUG_MODE=false

# 是否启用结构化输出（默认 true）。
# 豆包等不支持 json_object 的模型需设为 false；GPT/Gemini 建议保持 true。
ENABLE_RESPONSE_FORMAT=true

# 是否启用 enable_thinking 参数（默认 false）。部分推理模型需要。
ENABLE_THINKING=false

# 跳过 AI 分析（默认 false）。设为 true 则只走关键词规则，不调用模型。
SKIP_AI_ANALYSIS=false

# 图片分析模式（默认 auto）：
#   auto = 按需带图分析   on = 强制带图   off = 不带图（省 token）
AI_IMAGE_MODE=auto

# AI 分析并发数（默认 2）。过大可能触发模型端限流。
AI_ANALYSIS_CONCURRENCY=2

# 商品图片下载并发数（默认 3）。
IMAGE_DOWNLOAD_CONCURRENCY=3

# 卖家信息缓存有效期（秒，默认 1800）。降低可减少重复请求。
SELLER_PROFILE_CACHE_TTL=1800

# --- AI 用量成本统计（用于网页"AI 用量"页估算费用，单位：元/百万 token）---
# 默认值对应 DeepSeek 的计价，用别的模型请按实际价格改。
DEEPSEEK_CACHE_HIT_COST_PER_MILLION=0.028
DEEPSEEK_CACHE_MISS_COST_PER_MILLION=0.28
DEEPSEEK_OUTPUT_COST_PER_MILLION=0.42


################################################################################
# 3. 通知推送
#    6 类渠道，任配其一即可收到通知（可同时配多个，会并发推送）。
#    全部留空则只有网页查看，无推送。
################################################################################

# --- 3.1 ntfy（自建/公共服务器，跨平台）---
# 例：https://ntfy.sh/你的主题名
# NTFY_TOPIC_URL=

# --- 3.2 Bark（iOS 推荐，本项目默认主力渠道）---
# 在 https://bark.day.app 注册后拿到 key，格式：https://api.day.app/你的key
# ⚠️ 不要保留 YOUR_BARK_KEY 占位符，含 "your_" 会被判定为未配置。
# BARK_URL=

# --- 3.3 Gotify（自建推送服务器，需 URL + Token 成对配置）---
# GOTIFY_URL=https://gotify.example.com
# GOTIFY_TOKEN=

# --- 3.4 企业微信机器人（群机器人 Webhook）---
# WX_BOT_URL=

# --- 3.5 Telegram 机器人（Token 与 Chat ID 需成对配置）---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Bot API 反代地址（可选），默认 https://api.telegram.org
# TELEGRAM_API_BASE_URL=

# --- 3.6 通用 Webhook（自定义 HTTP 推送，最灵活）---
# WEBHOOK_URL=
# 请求方法，默认 POST
# WEBHOOK_METHOD=POST
# 请求头，JSON 字符串格式，需整体加引号
# WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
# 请求体类型：JSON 或 FORM
# WEBHOOK_CONTENT_TYPE=JSON
# URL 查询参数，JSON 字符串；{{title}} / {{content}} 为占位符
# WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
# 请求体内容，JSON 字符串；{{title}} / {{content}} 为占位符
# WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'

# --- 3.7 邮件（SMTP，第 7 类渠道）---
# 启用条件：SMTP_HOST 与 MAIL_TO 同时填写；其余可选。
# SMTP_HOST=smtp.example.com
# 端口留空时按加密方式取默认值：SSL 用 465，STARTTLS 用 587
# SMTP_PORT=465
# 登录账号；多数邮箱服务用「授权码」而非登录密码
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# 发件人，留空则用 SMTP_USER
# MAIL_FROM=
# 收件人，多个用英文逗号分隔
# MAIL_TO=you@example.com
# 是否用 SSL 直连（465 常用）。与 SMTP_USE_STARTTLS 一般只开一个。
# SMTP_USE_SSL=true
# 是否用 STARTTLS 升级（587 常用）；仅在 SMTP_USE_SSL=false 时生效
# SMTP_USE_STARTTLS=false

# 是否把电脑端商品链接转换为手机端链接（默认 true）。
# 手机端链接配合 App 打开体验更好，建议保持 true。
PCURL_TO_MOBILE=true


################################################################################
# 4. 爬虫与浏览器
################################################################################

# 无头模式（默认 true）。
# ⚠️ Docker 部署必须为 true；设为 false 需要容器内有显示设备，否则启动失败。
# 遇到滑动验证码时，推荐在网页端用扫码登录更新登录态，而不是关掉无头模式。
RUN_HEADLESS=true

# 是否使用 Edge 内核（默认 false）。
# 仅影响本地运行；容器内缺少 Edge，会固定回落到 Chromium。
LOGIN_IS_EDGE=false

# 默认登录态文件路径（默认 xianyu_state.json，位于工作目录）。
# 通常无需修改，账号管理走 state 目录。
STATE_FILE=xianyu_state.json

# 账号登录态目录（默认 state）。账号管理页写入的 JSON 都在这里。
ACCOUNT_STATE_DIR=state

# 手动指定浏览器可执行文件路径（可选）。留空则自动探测镜像内 Chromium。
# 仅在镜像内浏览器缺失时才需要设置。
# PLAYWRIGHT_EXECUTABLE_PATH=
# BROWSER_EXECUTABLE_PATH=


################################################################################
# 5. 账号轮换（多账号分摊采集、降低单号风控风险）
################################################################################

# 是否启用账号轮换（默认 false）。state 目录下需有多个账号 JSON。
ACCOUNT_ROTATION_ENABLED=false

# 轮换模式（默认 per_task）：per_task = 每任务换号，on_failure = 失败才换号
ACCOUNT_ROTATION_MODE=per_task

# 单任务内因账号问题重试上限（默认 2）
ACCOUNT_ROTATION_RETRY_LIMIT=2

# 账号被拉黑后的冷却时间（秒，默认 300）
ACCOUNT_BLACKLIST_TTL=300


################################################################################
# 6. 代理轮换（IP 分摊，进一步降低风控）
################################################################################

# 是否启用代理轮换（默认 false）
PROXY_ROTATION_ENABLED=false

# 轮换模式（默认 per_task）：per_task / on_failure
PROXY_ROTATION_MODE=per_task

# 代理列表，逗号分隔。例：http://ip:port,socks5://ip:port
PROXY_POOL=

# 单任务内因代理问题重试上限（默认 2）
PROXY_ROTATION_RETRY_LIMIT=2

# 代理被拉黑后的冷却时间（秒，默认 300）
PROXY_BLACKLIST_TTL=300


################################################################################
# 7. 任务失败保护
#    连续失败（如登录态失效）达到阈值自动暂停任务，避免持续无效请求触发风控。
################################################################################

# 连续失败几次后暂停（默认 3）
TASK_FAILURE_THRESHOLD=3

# 暂停时长（秒，默认 86400 即 24 小时）
TASK_FAILURE_PAUSE_SECONDS=86400

# 失败状态记录文件路径（默认 logs/task-failure-guard.json，已随 logs 目录持久化）
TASK_FAILURE_GUARD_PATH=logs/task-failure-guard.json

# 失败计时所用时区（默认 Asia/Shanghai）
TASK_FAILURE_TZ=Asia/Shanghai


################################################################################
# 8. 采集与自动咨询
#    这里配的是新建任务时的默认值，单个任务可在网页上单独覆盖。
################################################################################

# 新建任务的默认采集间隔（分钟，默认 30；0 表示不自动采集，仅手动触发）
TASK_DEFAULT_COLLECTION_INTERVAL_MINUTES=30

# 采集失败重试次数（默认 2）
TASK_DEFAULT_RETRY_LIMIT=2

# 重试间隔基数（秒，默认 5）
TASK_DEFAULT_RETRY_BACKOFF_SECONDS=5

# 默认账号策略（默认 auto）：auto = 自动选择 / rotate = 轮换 / fixed = 固定账号
TASK_DEFAULT_ACCOUNT_STRATEGY=auto

# 新建任务默认是否开启自动咨询卖家（默认 false）
AUTO_CONSULT_DEFAULT_ENABLED=false

# 自动咨询话术
AUTO_CONSULT_TEMPLATE=您好，这件商品还在吗？当前价格可以直接购买吗？

# 同一商品的咨询冷却时间（小时，默认 24），避免重复骚扰卖家
AUTO_CONSULT_COOLDOWN_HOURS=24


################################################################################
# 9. 日志保留与账号保活
################################################################################

# 任务运行日志保留天数（默认 7）。
# 启动时自动清理 logs/ 下超过该天数的历史日志，防止磁盘涨满。
TASK_LOG_RETENTION_DAYS=7

# 账号登录态自动检测间隔（小时，默认 4）。定期保活并发现失效账号。
ACCOUNT_CHECK_INTERVAL_HOURS=4


################################################################################
# 9.1 AI 调用治理（并发闸 / 结果缓存 / 预算守卫）
################################################################################

# 全局 AI 并发上限（默认 4）。多个采集任务并行时，把「同时在飞的 AI 请求数」
# 钉在这个常数上，超出部分排队而不是失败，避免撞上游限流。
AI_MAX_CONCURRENCY=4

# AI 分析结果缓存 TTL（秒，默认 900）。同一商品被多个任务命中时直接复用结果，
# 不再重复付费。缓存键覆盖模型、提示词、图片内容与采样参数，任一变化都会重新请求。
AI_CACHE_TTL_SECONDS=900

# 结果缓存条目上限（默认 500），超出按 LRU 淘汰。
AI_CACHE_MAX_ENTRIES=500

# AI 花费上限（与币种无关，取决于模型计价单位）。**留空 = 不限制**，这是默认行为。
# 配置后会按当日 ai_usage_stats 的 estimated_cost 累计判定：
# 达到上限即拦截新请求（命中缓存的调用不受影响，因为读缓存不产生费用）。
# AI_BUDGET_LIMIT=

# 预算预警比例（默认 0.8）。用量达到上限的该比例时打印提醒，但仍放行。
AI_BUDGET_WARN_RATIO=0.8

# 已花费金额的缓存秒数（默认 60），避免每次 AI 调用都打一次聚合查询。
AI_BUDGET_CACHE_SECONDS=60


################################################################################
# 9.2 数据保留清理
################################################################################

# 是否真正执行保留清理（默认 false）。
# **默认只扫描不删除**：关闭时 /api/storage/retention/execute 只返回计划、不删任何数据。
# 且无论此处如何配置，调用该接口时都必须显式带 confirm=true 才会真正删除
# （两道独立闸门，防止误触）。
DATA_RETENTION_ENABLED=false

# 清理扫描的根目录。留空 = 项目根目录（即 src/services/ 的上两级）。
# 容器部署时若把日志挂在独立数据卷，需要显式指向该卷。
# DATA_RETENTION_ROOT=

# 各表/目录的保留天数。0 或负数是**非法值**，会回落到下面的默认值，
# 绝不会被解释成「删除全部数据」。
RESULT_ITEMS_RETENTION_DAYS=90
PRICE_SNAPSHOTS_RETENTION_DAYS=180
WATCH_EVENTS_RETENTION_DAYS=180
LOGS_RETENTION_DAYS=30
AI_USAGE_RETENTION_DAYS=365


################################################################################
# 10. 行情日报
#     ⚠️ 日报的开关与推送时间**实际由网页「设置 - 行情日报」控制**，
#        该配置存在 SQLite（data/app.sqlite3）里，改完即时生效。
#        下面两个环境变量目前仅在配置模型里声明、未被运行逻辑读取，
#        保留是为了兼容历史配置，改了不会有任何效果。
################################################################################

# （当前无效，请用网页设置页）日报开关
# DAILY_REPORT_ENABLED=true
# （当前无效，请用网页设置页）日报推送小时，0-23
# DAILY_REPORT_HOUR=9


################################################################################
# 11. 调试专用（正常部署不要开）
################################################################################

# 采集数量上限，仅用于联调排查，避免一次跑全量商品。
# 留空表示不限制。例：SPIDER_DEBUG_LIMIT=3
# SPIDER_DEBUG_LIMIT=
